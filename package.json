{
  "name": "dsh-tone",
  "version": "0.2.0",
  "description": "给 DSH 加一个语气档位旋钮：侧边滑一下 0-10，每轮把档位写进系统提示，Agent 的口气立刻跟着变。四档文案可自己改，也能一键停用。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tone",
    "persona",
    "style",
    "system-prompt",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/widget.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.png",
  "license": "MIT",
  "author": "六月六",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mastiff-No/dsh-tone.git"
  },
  "homepage": "https://github.com/Mastiff-No/dsh-tone#readme",
  "bugs": {
    "url": "https://github.com/Mastiff-No/dsh-tone/issues"
  }
}
