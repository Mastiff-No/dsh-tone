{
  "name": "dsh-tone",
  "version": "0.5.3",
  "description": "给 DSH 加一个语气档位旋钮：侧边滑一下 0-10，每轮把档位写进系统提示；档位会同时影响采样温度。四档文案可自己改，也能一键停用，面板里能直接看到模型这一轮到底读到了什么。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tone",
    "persona",
    "style",
    "system-prompt",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "cordis.patch.yml",
    "icon.png",
    "LICENSE",
    "README.md",
    "lib/index.js",
    "lib/levels.default.json",
    "lib/sets.default.json",
    "lib/widget.js",
    "test/smoke.mjs",
    "test/demo.mjs",
    "test/diff.mjs",
    "CHANGELOG.md",
    "verify.sh"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.png",
  "license": "MIT",
  "author": "六月六",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mastiff-No/dsh-tone.git"
  },
  "homepage": "https://github.com/Mastiff-No/dsh-tone#readme",
  "bugs": {
    "url": "https://github.com/Mastiff-No/dsh-tone/issues"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "demo": "node test/demo.mjs",
    "diff": "node test/diff.mjs"
  }
}
